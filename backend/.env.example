PORT=3000
NODE_ENV=development

# AI Provider — switch between 'openai' | 'anthropic' | 'mock'
AI_PROVIDER=mock

# OpenAI (if AI_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Anthropic Claude (if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Marketing brain model — default claude-haiku-4-5 (cheap+fast).
# Options: claude-sonnet-5 (deeper) | claude-opus-4-8 (max quality)
MARKETING_MODEL=claude-haiku-4-5

# Upload settings
MAX_FILE_SIZE_MB=200
UPLOAD_DIR=./uploads
OUTPUT_DIR=./uploads/output

# CORS
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081
